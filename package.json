{
  "name": "music-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && cp dist/index.html dist/404.html"
  },
  "dependencies": {
    "expo": "~51.0.39",
    "expo-av": "~14.0.7",
    "expo-blur": "~13.0.3",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-image": "~1.13.0",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-status-bar": "~1.12.1",
    "jest": "^29.4.0",
    "jest-expo": "~51.0.4",
    "react": "18.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "4.14.1",
    "react-native-screens": "3.37.0",
    "react-native-web": "~0.21.4",
    "react-dom": "18.3.1",
    "@expo/metro-runtime": "~3.2.3",
    "expo-asset": "~10.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.45",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint-parser": "^22.0.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
